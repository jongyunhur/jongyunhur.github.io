<ul class="entry-list">
  {% for publication in include.publications %}
    <li class="entry">
      <h3 class="entry-title">{{ publication.title | escape }}</h3>
      <p class="entry-subtitle">
        {% for author in publication.authors %}
          {%- if author == site.title -%}<strong>{{ author | escape }}</strong>{%- else -%}{{ author | escape }}{%- endif -%}
          {%- unless forloop.last -%}, {% endunless -%}
        {% endfor %}
      </p>
      <p class="entry-date">{{ publication.venue | escape }}</p>
      <p class="entry-description">{{ publication.description | escape }}</p>
      <p class="entry-description"><a href="{{ publication.program_url }}">Conference program</a></p>
    </li>
  {% endfor %}
</ul>
